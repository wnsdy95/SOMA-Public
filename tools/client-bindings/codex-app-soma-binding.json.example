{
  "schema": "soma.client_binding.v1",
  "client": "codex-app",
  "status": "reference_binding",
  "trust_boundary": "This manifest does not prove Codex app installed or called the hook; it fixes the wrapper contract a Codex app integration must call.",
  "lifecycle": {
    "event_source": "codex-app_private_lifecycle_hook",
    "wrapper": "tools/soma-codex-app-capture.sh",
    "environment": {
      "SOMA_ADAPTER_LIFECYCLE_CLIENT": "codex-app",
      "SOMA_ADAPTER_LIFECYCLE_EVENT": "assistant_response",
      "SOMA_ADAPTER_LIFECYCLE_EVENT_SOURCE": "codex-app_private_lifecycle_hook",
      "SOMA_ADAPTER_LIFECYCLE_BINDING_NONCE": "codex-app_reference_binding_nonce",
      "SOMA_ADAPTER_LIFECYCLE_JSONL": "$HOME/.soma/adapter/events.jsonl",
      "SOMA_ADAPTER_LIFECYCLE_PROJECT": "$SOMA_PROJECT",
      "SOMA_ADAPTER_LIFECYCLE_SESSION": "$SOMA_SESSION_ID",
      "SOMA_ADAPTER_LIFECYCLE_CWD": "$PWD"
    },
    "sample_event": {
      "event": "assistant_response",
      "thread_id": "codex-app-binding-session",
      "prompt_text": "Review the Codex app binding contract.",
      "output_text": "1. Codex app cloud output remains draft evidence until trusted verification.",
      "project": "soma-client-binding",
      "session_id": "codex-app-binding-session",
      "cwd": "/tmp/soma-client-binding",
      "client": "codex-app",
      "enqueue_proposal": true,
      "proposal_reason": "Codex app binding smoke creates a review-only verification request."
    }
  },
  "spool_drain": {
    "wrapper": "tools/soma-adapter-spool-watch.sh",
    "native_command": "soma adapter-spool --jsonl $SOMA_ADAPTER_SPOOL_JSONL",
    "checkpoint": "$HOME/.soma/adapter/events.offset"
  },
  "review_ui": {
    "wrapper": "tools/soma-review-render.sh",
    "environment": {
      "SOMA_REVIEW_CLIENT": "codex-app",
      "SOMA_REVIEW_PROJECT": "soma-client-binding",
      "SOMA_REVIEW_SESSION_ID": "codex-app-binding-session",
      "SOMA_REVIEW_FORMAT": "json"
    },
    "read_only_contract": "review_render_is_read_only_and_never_records_verification_or_applies_proposals_or_ack",
    "mutation_boundary": "Call soma_review_digest_ack only after visible notification; call soma_review_action or soma_review_batch only after trusted user/tool/test/local/correction evidence."
  },
  "proof_commands": [
    "tools/client-binding-smoke.sh",
    "tools/mcp-adapter-config-smoke.sh",
    "tools/client-integration-eval.sh --check-docs-report"
  ]
}
